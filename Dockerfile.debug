# syntax=docker/dockerfile:1
#
# DEBUG GPU-optimized Dockerfile for docling-serve with CUDA 12.8
#
# Extends the production Dockerfile with:
#   - Full pipeline profiling (every stage logged to stdout)
#   - Per-crop OCR timing and dimension logging
#   - VLM inference speed tracking (tokens/sec)
#   - vLLM backend for 6.8x faster VLM inference
#   - Standalone model benchmark scripts
#   - Granite-Docling-258M VLM model for pipeline comparison
#   - Startup diagnostics
#   - All debug features toggleable via ENABLE_PROFILING env var
#
# Build:
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile.debug -t docling-serve-debug .
#
# Run (debug enabled by default):
#   docker run --gpus all -p 5001:5001 docling-serve-debug
#
# Run with debug disabled (production mode, OpenShift):
#   docker run --gpus all -p 5001:5001 -e ENABLE_PROFILING=false docling-serve-debug
#
# View profiling output:
#   docker logs <id> 2>&1 | grep "\[PROFILE\]"
#
# Run standalone benchmarks:
#   docker exec -it <id> python3 /opt/app-root/src/benchmark_models.py
#   docker exec -it <id> python3 /opt/app-root/src/benchmark_onnx_sessions.py

# ============================================================
# Stage 1: builder (devel image — has nvcc, CUDA headers)
# ============================================================
FROM nvidia/cuda:12.8.0-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv \
        ninja-build g++ pkg-config \
        git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ---------- uv package manager ----------
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv && \
    mv /root/.local/bin/uvx /usr/local/bin/uvx

# ---------- Directory layout ----------
ENV APP_ROOT=/opt/app-root \
    HOME=/opt/app-root/src \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/app-root \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_CACHE_DIR=/opt/uv/cache

RUN mkdir -p \
        /opt/app-root/src/.local/bin \
        /opt/app-root/src/.cache/docling/models \
        /opt/app-root/src/.cache/huggingface/hub \
        /opt/app-root/src/.cache/torch \
        /opt/uv/python \
        /opt/uv/cache

ENV PATH=/opt/app-root/src/.local/bin:/opt/app-root/src/bin:/opt/app-root/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /opt/app-root/src

# ---------- Create venv ----------
RUN uv venv --python /usr/bin/python3.12 --clear /opt/app-root

# ---------- Clone docling-serve ----------
ARG DOCLING_SERVE_REF=v1.14.3
RUN git clone --depth 1 --branch ${DOCLING_SERVE_REF} \
        https://github.com/docling-project/docling-serve.git /opt/docling-serve

# ---------- Install dependencies (two-pass for flash-attn) ----------
# Pass 1: everything except flash-attn (no CUDA compilation needed)
RUN --mount=type=cache,target=/opt/uv/cache \
    cd /opt/docling-serve && \
    umask 002 && \
    uv sync --frozen --no-dev --no-editable --all-extras \
        --no-group pypi --group cu128 \
        --no-extra flash-attn

# Pass 2: flash-attn — use prebuilt wheel (kernels for compute cap 8.0+, i.e. H100/H200)
ENV FLASH_ATTENTION_SKIP_CUDA_BUILD=TRUE
RUN --mount=type=cache,target=/opt/uv/cache \
    cd /opt/docling-serve && \
    umask 002 && \
    uv sync --frozen --no-dev --no-editable --all-extras \
        --no-group pypi --group cu128 \
        --no-build-isolation-package=flash-attn

# ---------- Fix ONNX Runtime: swap CPU for GPU (critical) ----------
RUN --mount=type=cache,target=/opt/uv/cache \
    uv pip uninstall onnxruntime && \
    uv pip install --no-cache-dir onnxruntime-gpu

# ---------- Upgrade RapidOCR to v3.7.0 (PP-OCRv5 support) ----------
RUN --mount=type=cache,target=/opt/uv/cache \
    uv pip install --no-cache-dir "rapidocr>=3.7.0"

# ---------- Fix security vulnerabilities in builder (so COPY layer is clean) ----------
RUN uv pip install --no-cache-dir \
        "pillow>=12.1.1" \
        "cryptography>=46.0.5"

# ---------- Install vLLM for accelerated VLM inference (6.8x over transformers) ----------
# vLLM adjusts torch (2.10→2.9.1) and torchvision to compatible versions.
# Reinstall flash-attn with --no-deps to avoid re-upgrading torch (which would break torchvision).
# Re-ensure onnxruntime-gpu is present (vLLM may pull in CPU-only onnxruntime).
RUN --mount=type=cache,target=/opt/uv/cache \
    uv pip install vllm && \
    uv pip install --no-deps --force-reinstall "flash-attn>=2.7" \
        --find-links https://github.com/Dao-AILab/flash-attention/releases/expanded_assets/v2.8.3 && \
    uv pip install --no-cache-dir onnxruntime-gpu

# ---------- Build-time verification ----------
RUN /opt/app-root/bin/python3 -c "\
import onnxruntime as ort; \
providers = ort.get_available_providers(); \
print('ORT providers:', providers); \
assert 'CUDAExecutionProvider' in providers, \
    f'CUDAExecutionProvider missing! Got: {providers}'; \
print('ONNX Runtime GPU verification: PASSED'); \
"

# ---------- Cleanup & permission prep before COPY to runtime ----------
RUN rm -rf /opt/docling-serve /opt/uv/cache \
    && find /opt/app-root -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true \
    && chmod -R g=u /opt/app-root

# ============================================================
# Stage 2: runtime (runtime image — much smaller, no nvcc/headers)
# ============================================================
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv \
        tesseract-ocr tesseract-ocr-eng libleptonica-dev \
        libgl1 libglib2.0-0t64 libsm6 libxext6 libxrender1 \
        curl ca-certificates \
    && apt-get upgrade -y gnupg gpgv \
    && rm -rf /var/lib/apt/lists/*

# ---------- Copy venv + uv from builder ----------
COPY --chown=1001:0 --from=builder /opt/app-root /opt/app-root
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv

# ---------- Wire NVIDIA pip libraries into the dynamic linker ----------
RUN find /opt/app-root/lib/python3.12/site-packages/nvidia \
        -maxdepth 2 -type d -name lib -print \
        > /etc/ld.so.conf.d/pip-nvidia.conf && \
    ldconfig

# ---------- Environment variables ----------
ENV APP_ROOT=/opt/app-root \
    HOME=/opt/app-root/src \
    PATH=/opt/app-root/src/.local/bin:/opt/app-root/src/bin:/opt/app-root/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/extras/CUPTI/lib64 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    DOCLING_SERVE_ARTIFACTS_PATH=/opt/app-root/src/.cache/docling/models \
    DOCLING_ARTIFACTS_PATH=/opt/app-root/src/.cache/docling/models \
    HF_HOME=/opt/app-root/src/.cache/huggingface \
    TRANSFORMERS_CACHE=/opt/app-root/src/.cache/huggingface \
    HF_HUB_CACHE=/opt/app-root/src/.cache/huggingface/hub \
    TORCH_HOME=/opt/app-root/src/.cache/torch \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata/

WORKDIR /opt/app-root/src

# ---------- Copy pre-downloaded models (standard pipeline) ----------
COPY --chown=1001:0 models/docling-project--docling-layout-heron   ${DOCLING_SERVE_ARTIFACTS_PATH}/docling-project--docling-layout-heron
COPY --chown=1001:0 models/docling-project--docling-models         ${DOCLING_SERVE_ARTIFACTS_PATH}/docling-project--docling-models
COPY --chown=1001:0 models/docling-project--DocumentFigureClassifier-v2.0 ${DOCLING_SERVE_ARTIFACTS_PATH}/docling-project--DocumentFigureClassifier-v2.0
COPY --chown=1001:0 models/RapidOcr                                ${DOCLING_SERVE_ARTIFACTS_PATH}/RapidOcr
COPY --chown=1001:0 models/EasyOcr                                 ${DOCLING_SERVE_ARTIFACTS_PATH}/EasyOcr

# ---------- Copy VLM models for debug/benchmarking ----------
# granite-docling-258M: single-pass VLM for full document conversion
# Before building, copy the model into the build context:
#   cp -a ~/neo/docling-models/ibm-granite--granite-docling-258M models/
COPY --chown=1001:0 models/ibm-granite--granite-docling-258M \
    ${DOCLING_SERVE_ARTIFACTS_PATH}/ibm-granite--granite-docling-258M

# ---------- Tuning & feature ENV ----------
ENV TORCH_COMPILE_DISABLE=1 \
    TORCHINDUCTOR_DISABLE=1 \
    DOCLING_PICTURE_DESCRIPTION_MODEL_TYPE=vlm \
    DOCLING_PICTURE_DESCRIPTION_VLM_MODEL_ID=ibm-granite/granite-vision-3.3-2b \
    DOCLING_PICTURE_DESCRIPTION_VLM_DEVICE=cuda \
    DOCLING_PICTURE_DESCRIPTION_BACKEND=vlm \
    DOCLING_SERVE_ENGINE=DoclingParseV2DocumentBackend \
    DOCLING_SERVE_MAX_SYNC_WAIT=1200 \
    DOCLING_SERVE_MAX_DOCUMENT_TIMEOUT=1200 \
    DOCLING_SERVE_ENG_LOC_NUM_WORKERS=2 \
    ENABLE_PROFILING=true

# ---------- Save baked-in classifier ----------
RUN cp -a "${DOCLING_SERVE_ARTIFACTS_PATH}/docling-project--DocumentFigureClassifier-v2.0" \
          /opt/app-root/docling-project--DocumentFigureClassifier-v2.0-baked

# ---------- Patch RapidOCR: enable CUDA for ONNX Runtime (bug #5) ----------
# docling sets Det.use_cuda but RapidOCR v3.7.0 reads EngineConfig.onnxruntime.use_cuda
# which defaults to false — this patch adds the correct config key
RUN RAPID_OCR_MODEL=$(find /opt/app-root/lib/python3.12/site-packages/docling -name "rapid_ocr_model.py" | head -1) && \
    echo "Patching: $RAPID_OCR_MODEL" && \
    /opt/app-root/bin/python3 -c "\
from pathlib import Path; \
p = Path('$RAPID_OCR_MODEL'); \
src = p.read_text(); \
src = src.replace( \
    '\"EngineConfig.paddle.use_cuda\": use_cuda,', \
    '\"EngineConfig.onnxruntime.use_cuda\": use_cuda,\n' \
    '                \"EngineConfig.onnxruntime.cuda_ep_cfg.device_id\": gpu_id,\n' \
    '                \"EngineConfig.paddle.use_cuda\": use_cuda,' \
); \
p.write_text(src); \
print('CUDA patch applied successfully'); \
" && \
    grep -q 'EngineConfig.onnxruntime.use_cuda' "$RAPID_OCR_MODEL" || \
        { echo "FATAL: RapidOCR CUDA patch failed"; exit 1; }

# ============================================================
# DEBUG-SPECIFIC LAYERS
# ============================================================

# ---------- Patch 3.10: TimeRecorder — conditional profiling output ----------
# Uses dprint() (defined in sitecustomize.py) so output is controlled by ENABLE_PROFILING
RUN /opt/app-root/bin/python3 -c "\
import pathlib, glob; \
f = glob.glob('/opt/app-root/lib/python3.12/site-packages/docling/utils/profiling.py')[0]; \
p = pathlib.Path(f); \
src = p.read_text(); \
old = 'self.conv_res.timings[self.key].count += 1'; \
new = old + '\n            dprint(f\"[PROFILE] {self.key}: {elapsed:.4f}s\")'; \
assert old in src, f'Pattern not found in {f}'; \
p.write_text(src.replace(old, new, 1)); \
print(f'Patched TimeRecorder in {f}'); \
"

# ---------- Patch 3.1: RapidOCR per-crop timing + region count ----------
RUN /opt/app-root/bin/python3 -c "\
import pathlib, glob; \
f = glob.glob('/opt/app-root/lib/python3.12/site-packages/docling/**/rapid_ocr_model.py', recursive=True)[0]; \
p = pathlib.Path(f); \
src = p.read_text(); \
# Add region count after get_ocr_rects
old1 = 'ocr_rects = self.get_ocr_rects(page)'; \
new1 = old1 + '\n                    dprint(f\"[PROFILE] OCR page {page.page_no}: {len(ocr_rects)} regions detected\")'; \
src = src.replace(old1, new1, 1); \
# Add per-crop timer before self.reader() call
old2 = '                        result = self.reader('; \
new2 = '                        _ocr_crop_t0 = __import__(\"time\").perf_counter()\n' + old2; \
src = src.replace(old2, new2, 1); \
# Add per-crop timing after reader call, before result check
old3 = '                        if result is None or result.boxes is None:'; \
new3 = '                        _ocr_crop_elapsed = __import__(\"time\").perf_counter() - _ocr_crop_t0\n                        dprint(f\"[PROFILE] OCR crop: {im.shape[1]}x{im.shape[0]}px in {_ocr_crop_elapsed:.4f}s\")\n' + old3; \
src = src.replace(old3, new3, 1); \
p.write_text(src); \
assert '[PROFILE] OCR crop' in p.read_text(), 'Crop patch failed'; \
print(f'Patched RapidOCR per-crop in {f}'); \
"

# ---------- Patch 3.2: RapidOCR GPU config at init ----------
RUN /opt/app-root/bin/python3 -c "\
import pathlib, glob; \
f = glob.glob('/opt/app-root/lib/python3.12/site-packages/docling/**/rapid_ocr_model.py', recursive=True)[0]; \
p = pathlib.Path(f); \
src = p.read_text(); \
old = '            self.reader = RapidOCR('; \
new = '            dprint(f\"[PROFILE] RapidOCR config: backend={backend_enum}, use_cuda={use_cuda}, gpu_id={gpu_id}\")\n' + old; \
src = src.replace(old, new, 1); \
p.write_text(src); \
assert '[PROFILE] RapidOCR config' in p.read_text(), 'Config patch failed'; \
print(f'Patched RapidOCR config logging in {f}'); \
"

# ---------- Patch 3.9: Pipeline timing summary ----------
RUN /opt/app-root/bin/python3 -c "\
import pathlib, glob; \
f = glob.glob('/opt/app-root/lib/python3.12/site-packages/docling/pipeline/base_pipeline.py')[0]; \
p = pathlib.Path(f); \
src = p.read_text(); \
old = '                conv_res.status = self._determine_status(conv_res)'; \
NL = chr(10); \
SP = '                '; \
summary = old + NL + SP + 'dprint(\"[PROFILE] ===== PIPELINE TIMING SUMMARY =====\")' + NL + SP + 'for _tk, _tv in conv_res.timings.items():' + NL + SP + '    if _tv.times:' + NL + SP + '        dprint(f\"[PROFILE]   {_tk}: count={_tv.count}, total={sum(_tv.times):.4f}s, avg={sum(_tv.times)/len(_tv.times):.4f}s\")' + NL + SP + 'dprint(\"[PROFILE] =====================================\")'; \
assert old in src, f'Pattern not found in {f}'; \
src = src.replace(old, summary, 1); \
p.write_text(src); \
assert 'PIPELINE TIMING SUMMARY' in p.read_text(), 'Summary patch failed'; \
print(f'Patched pipeline summary in {f}'); \
"

# ---------- Profiling control ----------
ENV PYTHONUNBUFFERED=1

# ---------- Copy debug scripts ----------
COPY --chown=1001:0 docling_debug_profiler.py /opt/app-root/lib/python3.12/site-packages/docling/docling_debug_profiler.py
COPY --chown=1001:0 benchmark_models.py /opt/app-root/src/benchmark_models.py
COPY --chown=1001:0 benchmark_onnx_sessions.py /opt/app-root/src/benchmark_onnx_sessions.py
COPY --chown=1001:0 test_docling.py /opt/app-root/src/test_docling.py

# ---------- Enable profiling via system sitecustomize.py ----------
# Defines builtins.dprint() — a conditional print controlled by ENABLE_PROFILING env var.
# When ENABLE_PROFILING=false, all [PROFILE] output is suppressed silently.
# Also enables docling's internal TimeRecorder when debug is on.
RUN printf '%s\n' \
    '# Docling debug: conditional profiling controlled by ENABLE_PROFILING env var' \
    'import os, builtins' \
    '' \
    '_debug = os.environ.get("ENABLE_PROFILING", "true").lower() in ("true", "1", "yes")' \
    '' \
    'def _dprint(msg):' \
    '    if _debug:' \
    '        print(msg, flush=True)' \
    '' \
    'builtins.dprint = _dprint' \
    '' \
    'if _debug:' \
    '    def _enable_docling_profiling():' \
    '        try:' \
    '            from docling.datamodel.settings import settings' \
    '            settings.debug.profile_pipeline_timings = True' \
    '        except Exception:' \
    '            pass' \
    '    _enable_docling_profiling()' \
    > /usr/lib/python3.12/sitecustomize.py && \
    rm -f /usr/lib/python3.12/__pycache__/sitecustomize*.pyc

# ---------- Debug entrypoint ----------
COPY --chown=1001:0 debug_entrypoint.sh /usr/local/bin/debug-entrypoint
RUN chmod +x /usr/local/bin/debug-entrypoint

# ---------- Non-root user ----------
RUN echo "docling:x:1001:0:docling:/opt/app-root/src:/bin/bash" >> /etc/passwd && \
    chown -R 1001:0 /tmp && \
    chmod -R g=u /tmp

USER 1001

EXPOSE 5001 8080

ENTRYPOINT ["debug-entrypoint"]
CMD ["docling-serve", "run"]
